NODE_ENV=test
PORT=5001
CORS_ORIGINS=http://localhost:3000

# Isolated Disposable Neon Integration Test Branch (e.g. ali_integration_test)
# NEVER point this file to ali_dev or production.
TEST_APPROVED_ENDPOINTS=
TEST_EXPECTED_DB_NAME=medcodeai
DATABASE_URL=
DIRECT_URL=

# Authentication & JWT
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_ISSUER=medcodeai-api
JWT_AUDIENCE=medcodeai-client

# Isolated Seed Confirmation & Passwords
CONFIRM_DEV_SEED=true
SEED_TARGET_BRANCH=ali_integration_test
SEED_APPROVED_ENDPOINTS=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_PENDING_PASSWORD=
